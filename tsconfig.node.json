{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.ts",
    "vitest.config.mts",
    "playwright.config.ts",
    "e2e/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "electron-vite/node"],
    "paths": { "@shared/*": ["./src/shared/*"] }
  }
}
